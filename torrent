#!/bin/bash
set -euo pipefail
IMAGE="${TORRENT_IMAGE:-wireguard-aria2:local}"
NAME="wireguard-aria2-$(id -u)"
LABEL="io.github.xslim.wireguard-aria2"
STATE="${TORRENT_STATE_DIR:-$HOME/.local/state/wireguard-aria2}"
ROOT="${TORRENT_DOWNLOAD_ROOT:-$HOME/Downloads}"
WG="${TORRENT_WG_CONFIG:-$HOME/.config/wireguard/nordvpn.conf}"
die() { echo "$*" >&2; exit 1; }
usage() {
    cat <<'EOF'
Usage: torrent [-i] [add] <source> [--option=value ...]
       torrent [-i] <wireguard.conf> <source> [--option=value ...]
       torrent start [wireguard.conf]
       torrent list | status <gid> | pause <gid> | resume <gid> | remove <gid>
       torrent logs | stop
EOF
}
owned() {
    [ "$(docker inspect --type container --format '{{index .Config.Labels "io.github.xslim.wireguard-aria2"}}' "$NAME" 2>/dev/null)" = "queue" ]
}
rpc() { docker exec -i "$NAME" python3 /usr/local/bin/torrent-rpc.py "$@"; }
ready() {
    for ((n=0;n<60;n++)); do
        if rpc ready </dev/null >/dev/null 2>&1; then return; fi
        sleep 2
    done
    die "Queue not ready; run torrent logs."
}
start() {
    if docker inspect --type container "$NAME" >/dev/null 2>&1; then
        owned || die "Container name is already in use."
        if [ "$(docker inspect -f '{{.State.Running}}' "$NAME")" != true ]; then
            docker start "$NAME" >/dev/null
        fi
    else
        [ -f "$WG" ] || die "WireGuard config missing: $WG (set TORRENT_WG_CONFIG)"
        [ -d "$ROOT" ] || die "Download root missing: $ROOT"
        umask 077
        mkdir -p "$STATE"
        if [ ! -s "$STATE/rpc-secret" ]; then
            openssl rand -hex 32 > "$STATE/rpc-secret"
        fi
        touch "$STATE/session"
        docker run -d --init --name "$NAME" --label "$LABEL=queue" \
            --cap-add NET_ADMIN --device /dev/net/tun \
            -e PUID="$(id -u)" -e PGID="$(id -g)" \
            -e MAX_CONCURRENT="${TORRENT_MAX_CONCURRENT:-1}" \
            -v "$(realpath "$WG"):/gluetun/wireguard/wg0.conf:ro" \
            -v "$(realpath "$ROOT"):/downloads" \
            -v "$(realpath "$STATE"):/state" "$IMAGE" >/dev/null
    fi
    ready
}
INTERACTIVE=false
case "${1:-}" in
    -i|--interactive) INTERACTIVE=true; shift ;;
    -d|--detach) shift ;;
esac
case "${1:-}" in
    -h|--help|"") usage; exit 0 ;;
    start) shift; [ "$#" -le 1 ] || die "Expected at most one config"; WG="${1:-$WG}"; start; exit ;;
    list) owned || { echo "Queue has not been started."; exit 0; }; rpc list; exit ;;
    logs) owned || die "Queue has not been started."; exec docker logs -f "$NAME" ;;
    stop|shutdown) [ "$#" -eq 1 ] || die "Use torrent remove <gid> to remove a download."; owned || die "Queue has not been started."; exec docker stop -t 30 "$NAME" ;;
    status|pause|resume|remove)
        [ "$#" -eq 2 ] || die "Supply a download GID."
        owned || die "Queue has not been started."
        if [ "$1" = remove ]; then rpc stop "$2"; else rpc "$@"; fi; exit ;;
    add)
        shift
        case "${1:-}" in
            -i|--interactive) INTERACTIVE=true; shift ;;
        esac
        ;;
    *) if [[ "$1" == *.conf ]] && [ -f "$1" ]; then WG="$1"; shift; fi ;;
esac
[ "$#" -gt 0 ] || die "Supply a magnet link or torrent file."
SOURCE="$1"; shift
[ -n "$SOURCE" ] || die "No source provided."
[ -d "$ROOT" ] || die "Download directory missing: $ROOT"
ROOT="$(realpath "$ROOT")"
DEST=/downloads
if [ -f "$SOURCE" ]; then KIND=file
elif [[ "$SOURCE" == magnet:\?* ]]; then KIND=magnet
else die "Expected a torrent file or magnet link."
fi
if owned; then
    MOUNT="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/downloads"}}{{.Source}}{{end}}{{end}}' "$NAME")"
    [ "$MOUNT" = "$ROOT" ] || die "Download root differs from existing queue. Stop and recreate it first."
    if [ -f "$WG" ]; then
        MOUNT="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/gluetun/wireguard/wg0.conf"}}{{.Source}}{{end}}{{end}}' "$NAME")"
        [ "$MOUNT" = "$(realpath "$WG")" ] || die "VPN config differs from existing queue."
    fi
fi
start
if [ "$KIND" = file ]; then
    rpc add file "" "$DEST" "$INTERACTIVE" "$@" < "$SOURCE"
else
    rpc add magnet "$SOURCE" "$DEST" "$INTERACTIVE" "$@" </dev/null
fi
