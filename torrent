#!/bin/bash
set -euo pipefail
IMAGE="${TORRENT_IMAGE:-wireguard-aria2:local}"
LABEL="io.github.xslim.wireguard-aria2"
usage() {
    echo "Usage: torrent [-i|--interactive] <wireguard.conf> <torrent-file|magnet> [aria2 options]"
    echo "       torrent [-i] add [source]"
    echo "       torrent list | logs <id> | status <id> | stop <id>"
}
case "${1:-}" in
    list)
        [ "$#" -eq 1 ] || { usage >&2; exit 1; }
        exec docker ps --filter "label=$LABEL=true"
        ;;
    logs|status|stop)
        [ "$#" -eq 2 ] || { usage >&2; exit 1; }
        ID="$2"
        [[ "$ID" =~ ^[a-f0-9]{12,64}$ ]] || { echo "Use a container ID from torrent list." >&2; exit 1; }
        OWNED="$(docker inspect --type container --format '{{index .Config.Labels "io.github.xslim.wireguard-aria2"}}' "$ID")"
        [ "$OWNED" = true ] || { echo "Not a torrent container." >&2; exit 1; }
        case "$1" in
            logs) exec docker logs -f "$ID" ;;
            status) exec docker inspect --format '{{.State.Status}} (health: {{if .State.Health}}{{.State.Health.Status}}{{else}}n/a{{end}})' "$ID" ;;
            stop) exec docker stop "$ID" ;;
        esac
        ;;
    -h|--help) usage; exit 0 ;;
esac
DETACH=true
case "${1:-}" in
    -d|--detach) DETACH=true; shift ;;
    -i|--interactive) DETACH=false; shift ;;
esac
if [ "${1:-}" = add ]; then
    shift
    case "${1:-}" in
        -i|--interactive) DETACH=false; shift ;;
        -d|--detach) DETACH=true; shift ;;
    esac
    DEFAULT_WG="${TORRENT_WG_CONFIG:-$HOME/.config/wireguard/nordvpn.conf}"
    if [ -f "$DEFAULT_WG" ]; then
        WG_CONFIG="$DEFAULT_WG"
    else
        [ -t 0 ] || { echo "Set TORRENT_WG_CONFIG or supply an explicit config." >&2; exit 1; }
        printf 'WireGuard config [%s]: ' "$DEFAULT_WG" >&2
        IFS= read -r WG_CONFIG
        WG_CONFIG="${WG_CONFIG:-$DEFAULT_WG}"
    fi
    if [ "$#" -eq 0 ]; then
        [ -t 0 ] || { usage >&2; exit 1; }
        printf 'Magnet link or torrent file: ' >&2
        IFS= read -r SOURCE
        [ -n "$SOURCE" ] || { echo "No source provided." >&2; exit 1; }
        set -- "$SOURCE"
    fi
    set -- "$WG_CONFIG" "$@"
fi
if [ "$#" -lt 2 ]; then
    usage >&2
    exit 1
fi
WG_CONFIG="$1"
SOURCE="$2"
shift 2
[ -f "$WG_CONFIG" ] || { echo "WireGuard config not found." >&2; exit 1; }
WG_CONFIG="$(realpath "$WG_CONFIG")"
ARGS=()
if [ "$DETACH" = true ]; then
    ARGS+=(-d)
elif [ -t 0 ] && [ -t 1 ]; then
    ARGS+=(-it)
fi
if [ -f "$SOURCE" ]; then
    ARGS+=(-v "$(realpath "$SOURCE"):/input.torrent:ro")
    SOURCE=/input.torrent
elif [[ "$SOURCE" != magnet:\?* ]]; then
    echo "Expected a torrent file or magnet link." >&2
    exit 1
fi
exec docker run --rm --init --label "$LABEL=true" \
    ${ARGS[@]+"${ARGS[@]}"} \
    --cap-add NET_ADMIN --device /dev/net/tun \
    -e PUID="$(id -u)" -e PGID="$(id -g)" \
    -v "$WG_CONFIG:/gluetun/wireguard/wg0.conf:ro" \
    -v "$PWD:/downloads" \
    "$IMAGE" "$@" -- "$SOURCE"
